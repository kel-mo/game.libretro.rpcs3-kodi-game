From 3268ef041e7e06c6a6a2be19ec3097e5ec4f1613 Mon Sep 17 00:00:00 2001
From: Kel Modderman <kelvmod@gmail.com>
Date: Tue, 17 Nov 2026 15:42:43 +1000
Subject: [PATCH] Leave stick and trigger deadzones to the frontend

The frontend already applies the controller's deadzone, so a second
one in the core takes away more of the stick's travel. Remove the
Stick Deadzone, Stick Anti-Deadzone and Trigger Threshold options. The
pad handler then passes stick and trigger values through unchanged.

Assisted-by: Claude
---
 rpcs3/libretro/libretro_core.cpp       |  6 ------
 rpcs3/libretro/libretro_core_options.h | 24 ------------------------
 2 files changed, 30 deletions(-)

diff --git a/rpcs3/libretro/libretro_core.cpp b/rpcs3/libretro/libretro_core.cpp
index 19e5468..78e61ad 100644
--- a/rpcs3/libretro/libretro_core.cpp
+++ b/rpcs3/libretro/libretro_core.cpp
@@ -1031,12 +1031,6 @@ static void libretro_apply_core_options()
     std::string volume = get_option_value("rpcs3_master_volume", "100");
     g_cfg.audio.volume.set(std::stoi(volume));
 
-    // Stick Deadzone and Anti-Deadzone, read by the pad handler on every
-    // poll, so a change applies at once (rpcs3-libretro#3)
-    libretro_pad_set_stick_deadzones(std::stoi(get_option_value("rpcs3_stick_deadzone", "25")),
-        std::stoi(get_option_value("rpcs3_stick_anti_deadzone", "13")));
-    libretro_pad_set_trigger_threshold(std::stoi(get_option_value("rpcs3_trigger_threshold", "12")));
-
     // ==================== NETWORK OPTIONS ====================
     // None of these were read before: the network stayed off whatever they
     // said. The connection is set up when a game boots, so only between games.
diff --git a/rpcs3/libretro/libretro_core_options.h b/rpcs3/libretro/libretro_core_options.h
index 1132f3a..51f2a1c 100644
--- a/rpcs3/libretro/libretro_core_options.h
+++ b/rpcs3/libretro/libretro_core_options.h
@@ -628,30 +628,6 @@ struct retro_core_option_v2_definition option_defs_us[] = {
         { {"stereo", "Stereo"}, {"surround_5_1", "Surround 5.1"}, {"surround_7_1", "Surround 7.1"}, {NULL, NULL} },
         "stereo"
     },
-    /* Defaults as standalone RPCS3's SDL and XInput pad handlers: a deadzone
-     * of 8000 of 32767 (about 25%) and an anti-deadzone of 13% */
-    {
-        "rpcs3_stick_deadzone", "Stick Deadzone", NULL,
-        "How far a stick can be tilted before the game sees it move. Inside it the stick's output is scaled down to the Stick Anti-Deadzone rather than cut off, so a resting stick that drifts a little stays close to the centre. Applies to both sticks of every pad; RetroArch's own Analog Deadzone comes before it.",
-        NULL, "core",
-        { {"0", "0%"}, {"5", "5%"}, {"10", "10%"}, {"15", "15%"}, {"20", "20%"}, {"25", "25%"}, {"30", "30%"}, {"35", "35%"}, {"40", "40%"}, {NULL, NULL} },
-        "25"
-    },
-    {
-        "rpcs3_stick_anti_deadzone", "Stick Anti-Deadzone", NULL,
-        "Where the stick's output starts once it is tilted past the Stick Deadzone. Games for the DualShock 3 ignore a small tilt themselves, the deadzone of the pad they were made for; starting past it makes the slightest tilt count, for finer steering in racing games. 0% leaves the game's own deadzone in place. With a Stick Deadzone of 0% a stick that drifts makes the game move.",
-        NULL, "core",
-        { {"0", "0%"}, {"5", "5%"}, {"10", "10%"}, {"13", "13%"}, {"15", "15%"}, {"20", "20%"}, {"25", "25%"}, {"30", "30%"}, {NULL, NULL} },
-        "13"
-    },
-    /* Default as standalone RPCS3's XInput pad handler: 30 of 255 */
-    {
-        "rpcs3_trigger_threshold", "Trigger Threshold", NULL,
-        "How far L2 and R2 must be pressed before the game sees them; past it the press is scaled up from nothing to full. With a pad and frontend that report how far a trigger is pressed (analog triggers) the game gets that as the button's pressure, otherwise L2 and R2 stay all or nothing. 0% gives the whole travel of the trigger.",
-        NULL, "core",
-        { {"0", "0%"}, {"5", "5%"}, {"10", "10%"}, {"12", "12%"}, {"15", "15%"}, {"20", "20%"}, {"25", "25%"}, {"30", "30%"}, {"40", "40%"}, {"50", "50%"}, {NULL, NULL} },
-        "12"
-    },
     {
         "rpcs3_disk_cache_size", "Disk Cache Size", NULL,
         "Limits the cache games keep on dev_hdd1, which otherwise only grows. With a size, the games' caches used longest ago are deleted when a game is loaded or closed, until the rest fits. Wipe on Exit deletes all of it when a game is closed, as a PS3 does when it is switched off. A deleted cache is built again by its game, which can make that game's next start slower.",
